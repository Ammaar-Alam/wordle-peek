{
  "manifest_version": 3,
  "name": "Wordle Peek",
  "version": "1.3.2",
  "description": "Today's Wordle answer and every word that still fits your board.",
  "homepage_url": "https://github.com/Ammaar-Alam/wordle-peek",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Peek" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.nytimes.com/games/wordle/*"],
      "exclude_matches": ["https://www.nytimes.com/games/wordle/archive*"],
      "js": ["voice/vosk.js", "words.js", "solver.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["voice/model.tar.gz"], "matches": ["https://www.nytimes.com/*"] }
  ]
}
